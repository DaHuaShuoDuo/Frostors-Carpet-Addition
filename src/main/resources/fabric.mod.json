{
	"schemaVersion": 1,
	"id": "frostors-carpet-addition",
	"version": "${version}",
	"name": "Frostor's Carpet Addition",
	"description": "A Carpet addition by Frostor with a server-side big ender chest, Player Ladder, and other utilities.",
	"authors": [
		"Frostor"
	],
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"main": [
			"top.frostor.carpet.FrostorsCarpetAddition"
		]
	},
	"mixins": [
		"frostors-carpet-addition.mixins.json",
		"frostors-carpet-bigenderchest.mixins.json",
		"frostors-carpet-easyplace.mixins.json",
		"frostors-carpet-onlineprofile.mixins.json"
	],
	"depends": {
		"fabricloader": "${fabricloader_dependency}",
		"minecraft": "${minecraft_dependency}",
		"java": ">=25",
		"fabric-api": "${fabric_api_dependency}",
		"carpet": "${carpet_dependency}"
	}
}
